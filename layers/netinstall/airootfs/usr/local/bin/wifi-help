#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# wifi-help - explain how to get online on the BlackArch NetInstall ISO.
#
# Detects the Wi-Fi interface(s) and their adapter (phy) from sysfs and
# prints the iwctl commands with the real names filled in, so they can be
# typed as shown. Also reports rfkill blocks and whether iwd is running.
#
#   wifi-help           full guide, always
#   wifi-help --login   used by /etc/profile.d at login: one line if the
#                       machine is already online, the full guide if not
#
# With several Wi-Fi devices, all are listed and the commands use the
# best candidate: one that is not blocked, else one that is only
# soft-blocked (fixable with rfkill), else the first. Interfaces that are
# not in managed mode (e.g. monitor-mode wlan0mon after airmon-ng) are
# skipped, because iwd cannot run a station on them.
#
# Everything is read from sysfs and the routing table; nothing touches the
# network, so this is instant and safe to run at every login.
#
# Every line fits in 79 columns even for a 15-character interface name
# (IFNAMSIZ, e.g. USB dongles named wlx<mac>), and realistic worst cases
# fit an 80x25 console, so nothing wraps or scrolls off.

set -u

sys="${WIFI_HELP_SYSFS:-/sys}"   # overridable for testing
mode=full
[ "${1:-}" = "--login" ] && mode=login

if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then
  b=$'\033[1m' dim=$'\033[2m' red=$'\033[1;31m' grn=$'\033[1;32m'
  yel=$'\033[1;33m' cyn=$'\033[1;36m' rst=$'\033[0m'
else
  b='' dim='' red='' grn='' yel='' cyn='' rst=''
fi

readval() { cat "$1" 2>/dev/null; }

# --- connectivity ------------------------------------------------------------

default_dev() {
  ip -4 route show default 2>/dev/null |
    awk '{for(i=1;i<NF;i++) if($i=="dev"){print $(i+1); exit}}'
}

online=0
dev="$(default_dev)"
if [ -n "$dev" ] || ip -6 route show default 2>/dev/null | grep -q .; then
  online=1
fi

# --- Wi-Fi devices -----------------------------------------------------------
#
# rfkill is read per adapter: cfg80211 registers each phy's rfkill switch
# under the phy, reachable as <iface>/phy80211/rfkill*. Platform switches
# (ideapad_wlan, acer-wireless, hp-wifi, ...) are also type "wlan" but sit
# outside any phy, and block every radio at once, so they are applied to
# all devices.

ifaces=() phys=() softs=() hards=() skipped=()
declare -A phy_rfkill=()

for d in "$sys"/class/net/*; do
  [ -e "$d/phy80211" ] || [ -d "$d/wireless" ] || continue
  name="${d##*/}"

  # ARPHRD_ETHER (1) = managed/station-capable; monitor mode is 803.
  t="$(readval "$d/type")"
  if [ -n "$t" ] && [ "$t" != 1 ]; then
    skipped+=("$name")
    continue
  fi

  if [ -r "$d/phy80211/name" ]; then
    p="$(readval "$d/phy80211/name")"
  else
    p="$(basename "$(readlink -f "$d/phy80211" 2>/dev/null)")"
  fi

  s=0 h=0
  for r in "$d"/phy80211/rfkill*; do
    [ -e "$r" ] || continue
    phy_rfkill["${r##*/}"]=1
    [ "$(readval "$r/soft")" = 1 ] && s=1
    [ "$(readval "$r/hard")" = 1 ] && h=1
  done

  ifaces+=("$name") phys+=("$p") softs+=("$s") hards+=("$h")
done

# Platform wlan switches: type wlan, not belonging to any phy.
plat_soft=0 plat_hard=0
for r in "$sys"/class/rfkill/rfkill*; do
  [ -r "$r/type" ] || continue
  [ "$(readval "$r/type")" = wlan ] || continue
  [ -n "${phy_rfkill[${r##*/}]:-}" ] && continue
  [ "$(readval "$r/soft")" = 1 ] && plat_soft=1
  [ "$(readval "$r/hard")" = 1 ] && plat_hard=1
done
for i in "${!ifaces[@]}"; do
  [ "$plat_soft" = 1 ] && softs[$i]=1
  [ "$plat_hard" = 1 ] && hards[$i]=1
done

iwd_up=1
systemctl is-active --quiet iwd.service 2>/dev/null || iwd_up=0

# --- already online at login: stay out of the way ----------------------------

if [ "$mode" = login ] && [ "$online" = 1 ]; then
  printf '%s[+]%s Online%s.  Install: %sblackarch-install%s  Wi-Fi: %swifi-help%s\n' \
    "$grn" "$rst" "${dev:+ ($dev)}" "$b" "$rst" "$b" "$rst"
  exit 0
fi

# --- guide -------------------------------------------------------------------

if [ "$online" = 1 ]; then
  printf ' %s[+]%s Network is up%s.\n' "$grn" "$rst" "${dev:+ on $dev}"
else
  printf ' %s[!] No network connection.%s Wired? Plug in the cable: DHCP is automatic.\n' "$yel" "$rst"
fi
echo

if [ "${#ifaces[@]}" -eq 0 ]; then
  if [ "${#skipped[@]}" -gt 0 ]; then
    m="${skipped[0]}"
    printf ' %s[!] Wi-Fi is only in monitor mode:%s %s\n' "$red" "$rst" "${skipped[*]}"
    printf '     Return it to managed mode, then run %swifi-help%s again:\n' "$b" "$rst"
    printf '       %sip link set %s down%s\n' "$b" "$m" "$rst"
    printf '       %siw dev %s set type managed%s\n' "$b" "$m" "$rst"
    printf '       %sip link set %s up%s\n' "$b" "$m" "$rst"
  else
    # Each hint is shown only if its command is installed, so the user is
    # never told to run something that answers "command not found".
    # lspci -k first: a network controller with no "Kernel driver in use"
    # line is the usual cause (driver or firmware missing).
    hint() {  # hint <label> <command-to-check> <what-to-type>
      command -v "$2" >/dev/null 2>&1 &&
        printf '     %-26s%s%s%s\n' "$1" "$b" "$3" "$rst"
    }
    printf ' %s[!] No Wi-Fi device detected.%s\n' "$red" "$rst"
    hint "List interfaces:"         ip    "ip link"
    hint "Card present, driver?"    lspci "lspci -k | grep -iA3 network"
    hint "Missing firmware?"        dmesg "dmesg | grep -i firmware"
    hint "USB adapter plugged in?"  lsusb "lsusb"
  fi
  echo
  exit 0
fi

# Pick the device the commands will use: unblocked, else soft-blocked
# only (rfkill fixes that), else the first one.
pick=-1
for i in "${!ifaces[@]}"; do
  if [ "${hards[$i]}" = 0 ] && [ "${softs[$i]}" = 0 ]; then pick=$i; break; fi
done
if [ "$pick" = -1 ]; then
  for i in "${!ifaces[@]}"; do
    if [ "${hards[$i]}" = 0 ]; then pick=$i; break; fi
  done
fi
[ "$pick" = -1 ] && pick=0

w="${ifaces[$pick]}" p="${phys[$pick]:-phy0}"
soft="${softs[$pick]}" hard="${hards[$pick]}"

state() {  # state <index> -> "  (soft-blocked)" etc., or nothing
  if [ "${hards[$1]}" = 1 ]; then printf '  (hard-blocked)'
  elif [ "${softs[$1]}" = 1 ]; then printf '  (soft-blocked)'
  fi
}

if [ "${#ifaces[@]}" -eq 1 ]; then
  printf ' %sWi-Fi setup with iwd%s  %s(%s on %s)%s\n' "$cyn" "$rst" "$dim" "$w" "$p" "$rst"
else
  # One device per line: a joined list overflows 80 columns with two
  # 15-character USB interface names.
  printf ' %sWi-Fi setup with iwd%s  %s(examples use %s)%s\n' "$cyn" "$rst" "$dim" "$w" "$rst"
  for i in "${!ifaces[@]}"; do
    printf '   %s- %s on %s%s%s\n' "$dim" "${ifaces[$i]}" "${phys[$i]:-?}" "$(state "$i")" "$rst"
  done
fi
[ "${#skipped[@]}" -gt 0 ] &&
  printf ' %sSkipped, monitor mode: %s%s\n' "$dim" "${skipped[*]}" "$rst"
echo

[ "$hard" = 1 ] && printf ' %s[!] %s is hard-blocked:%s use the wireless switch or Fn key first.\n' "$red" "$w" "$rst"
[ "$iwd_up" = 0 ] && printf ' %s[!] iwd is not running:%s  %ssystemctl start iwd%s\n' "$red" "$rst" "$b" "$rst"
{ [ "$hard" = 1 ] || [ "$iwd_up" = 0 ]; } && echo

# Command column is sized to the longest command so the comments line up
# whatever the interface is called (wlan0 vs wlp0s20f3).
cmds=(
  "iwctl device list"
  "iwctl adapter $p set-property Powered on"
  "iwctl device $w set-property Powered on"
  "iwctl station $w scan"
  "iwctl station $w get-networks"
  "iwctl station $w connect \"SSID\""
  "ping -c 3 blackarch.org"
)
width=0
for c in "${cmds[@]}" "rfkill unblock wifi"; do
  [ "${#c}" -gt "$width" ] && width="${#c}"
done

step() {  # step <number-or-blank> <command> <comment>
  printf '  %-2s %s%-*s%s  %s# %s%s\n' "$1" "$b" "$width" "$2" "$rst" "$dim" "$3" "$rst"
}

n=1
if [ "$soft" = 1 ]; then
  step "$n" "rfkill unblock wifi" "radio soft-blocked"; n=$((n+1))
fi
step "$n" "${cmds[0]}" "confirm device";   n=$((n+1))
step "$n" "${cmds[1]}" "power on adapter"
step ""   "${cmds[2]}" "power on device";  n=$((n+1))
step "$n" "${cmds[3]}" "scan, wait ~3s";   n=$((n+1))
step "$n" "${cmds[4]}" "list networks";    n=$((n+1))
step "$n" "${cmds[5]}" "asks passphrase";  n=$((n+1))
step "$n" "${cmds[6]}" "test connection"

echo
printf ' An IP address is assigned automatically a few seconds after connecting.\n'
printf ' Put SSIDs containing spaces in quotes.\n'
printf ' Hidden network:  %siwctl station %s connect-hidden "SSID"%s\n' "$b" "$w" "$rst"
printf ' Tip: %siwctl%s alone opens a shell with Tab completion. Show again: %swifi-help%s\n' "$b" "$rst" "$b" "$rst"
echo
